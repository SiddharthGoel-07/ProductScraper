{
  "name": "ine-product-price-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Product Price Tracker - Express API (port 5000) + Supabase + React dashboard",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:server": "node --watch server.js",
    "dev:client": "npm --prefix client run dev",
    "dev:all": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install",
    "cron:once": "node scripts/cron.js",
    "test:api": "node scripts/smoke-test.js",
    "test:scraper": "node test_scraper.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
